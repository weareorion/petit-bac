        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\n\n    actor \&quot;Joueur\&quot; as User\n   \n    package \&quot;Application Petit Bac\&quot; {\n        usecase \&quot;Démarrer une partie\&quot; as UC1\n        usecase \&quot;Saisir les mots par catégorie\&quot; as UC2\n        usecase \&quot;Arrêter la partie (Stop !)\&quot; as UC3\n        usecase \&quot;Consulter son score\&quot; as UC4\n        usecase \&quot;Générer une lettre aléatoire\&quot; as UC5\n        usecase \&quot;Vérifier la validité des mots\&quot; as UC6\n        usecase \&quot;Décompter le temps (Timer)\&quot; as UC7\n    }\n\n    User --&gt; UC1\n    User --&gt; UC2\n    User --&gt; UC3\n    User --&gt; UC4\n\n    UC1 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\n    UC1 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\n    UC3 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\n    UC7 ..&gt; UC3 : &lt;&lt;trigger&gt;&gt;\n    @enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="AYH1exTm_4Yk7JWobLUu-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
