  <diagram id="qo1BttNEbP-GF6amRna5" name="Page-4">
    <mxGraphModel dx="1603" dy="811" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #FDF6E3\n  BorderColor Black\n  ArrowColor Black\n}\n\nactor \&quot;Joueur\&quot; as Joueur\nactor \&quot;Serveur\&quot; as Serveur\n\npackage \&quot;Jeu Baccalauréat Flutter\&quot; {\n  \n  usecase \&quot; Se connecter\&quot; as UC1\n  usecase \&quot;Lancer une partie\&quot; as UC3\n  usecase \&quot;Générer lettre aléatoire\&quot; as UC4\n  usecase \&quot;Afficher catégories\&quot; as UC5\n  usecase \&quot;Remplir les réponses\&quot; as UC6\n  usecase \&quot;Valider les réponses\&quot; as UC7\n  usecase \&quot;Soumettre les réponses\&quot; as UC8\n  usecase \&quot;Soumission automatique\&quot; as UC9\n  usecase \&quot;Calculer les scores\&quot; as UC10\n  usecase \&quot;Vérifier unicité des mots\&quot; as UC11\n  usecase \&quot;Afficher les résultats\&quot; as UC12\n  usecase \&quot;Gérer les paramètres\&quot; as UC13\n  usecase \&quot;Consulter l’historique\&quot; as UC14\n  usecase \&quot;Sauvegarder dans le cloud\&quot; as UC15\n}\n\nJoueur --&gt; UC1\nJoueur --&gt; UC3\nJoueur --&gt; UC6\nJoueur --&gt; UC8\nJoueur --&gt; UC12\nJoueur --&gt; UC13\nJoueur --&gt; UC14\n\nServeur --&gt; UC15\n\nUC3 --&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC3 --&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC6 --&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC8 --&gt; UC9 : &lt;&lt;extend&gt;&gt;\nUC10 --&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC12 --&gt; UC10 : &lt;&lt;include&gt;&gt;\nUC14 --&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC10 --&gt; UC15 : &lt;&lt;extend&gt;&gt;\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Zq4bjy0PCTUjzWnErivI-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
